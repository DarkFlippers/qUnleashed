app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# flipengine: local-only nested repo (github.com/apfxtech/flipper-engine), not part of qUnleashed.
/lib/modules/cpp/flipengine/

# wiki: clone of github.com/DarkFlippers/qUnleashed.wiki.git, its own repository.
/wiki/

# l10n: generated from translations/*.arb by flutter gen-l10n on every build.
/lib/services/localization/gen/

# Firebase configuration is restored from GitHub Secrets in CI.
/lib/services/notifications/firebase_options.dart
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/macos/Runner/GoogleService-Info.plist
